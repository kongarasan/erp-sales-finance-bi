table 'public fact_invoice'
	lineageTag: 14b636e8-b5f6-4dfb-94f4-dc0e51a1a777

	measure Revenue = SUM ( 'public fact_invoice'[net_amount] )
		formatString: €#,0
		lineageTag: 1499bd0f-cde0-41b7-8115-64084f568421

	measure 'Revenue Gross' = SUM ( 'public fact_invoice'[gross_amount] )
		formatString: €#,0
		lineageTag: c1e3c395-b4a2-494c-9123-f4d91fc66bd0

	measure 'Revenue PY' = CALCULATE ( [Revenue], SAMEPERIODLASTYEAR ( 'public dim_date'[full_date] ) )
		formatString: €#,0
		lineageTag: d1f6aa27-cfa3-4727-97fd-ad2b5f82051f

	measure 'Revenue YoY %' = VAR _cur = [Revenue] VAR _py = [Revenue PY] RETURN IF ( NOT ISBLANK ( _cur ) && NOT ISBLANK ( _py ), DIVIDE ( _cur - _py, _py ) )
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 5ad30741-c239-414b-a07b-319000e4df78

	measure 'Open Receivables' = CALCULATE ( SUM ( 'public fact_invoice'[gross_amount] ), 'public fact_invoice'[payment_status] = "OPEN", REMOVEFILTERS ( 'public dim_date' ) )
		formatString: €#,0
		lineageTag: dc2d5f87-297e-4486-9d3a-125e63d97f23

	measure DSO = VAR _lastDate = MAX ( 'public fact_invoice'[invoice_date] ) VAR _grossTTM = CALCULATE ( SUM ( 'public fact_invoice'[gross_amount] ), DATESINPERIOD ( 'public dim_date'[full_date], _lastDate, -365, DAY ) ) RETURN DIVIDE ( [Open Receivables], _grossTTM ) * 365
		formatString: 0.0 "days"
		lineageTag: 416ee39e-26ef-49cd-9ffe-1c72960bc3ee

	measure 'Overdue Amount' = VAR _asOf = CALCULATE ( MAX ( 'public fact_invoice'[invoice_date] ), REMOVEFILTERS () ) RETURN CALCULATE ( SUM ( 'public fact_invoice'[gross_amount] ), 'public fact_invoice'[payment_status] = "OPEN", 'public fact_invoice'[due_date] < _asOf, REMOVEFILTERS ( 'public dim_date' ) )
		formatString: €#,0
		lineageTag: 202387cf-7244-429b-96cc-f17ffe8c1964

	measure 'Overdue %' = DIVIDE ( [Overdue Amount], [Open Receivables] )
		formatString: 0.0%
		lineageTag: 8645a56f-11b7-444f-8edd-c7b5aee2cc3a

	measure 'Collection Rate' = DIVIDE ( CALCULATE ( SUM ( 'public fact_invoice'[gross_amount] ), 'public fact_invoice'[payment_status] = "PAID" ), [Revenue Gross] )
		formatString: 0.0%
		lineageTag: f8d49c41-23fa-49c4-8905-f0413b64c1a9

	measure 'Cash Collected' = CALCULATE ( SUM ( 'public fact_invoice'[gross_amount] ), USERELATIONSHIP ( 'public fact_invoice'[payment_date_key], 'public dim_date'[date_key] ) )
		formatString: €#,0
		lineageTag: 876ae71f-d70d-4610-9415-d573fd595d89

	measure 'Revenue YTD YoY %' = VAR _end = MAX ( 'public fact_invoice'[invoice_date] ) VAR _start = DATE ( YEAR ( _end ), 1, 1 ) VAR _cur = CALCULATE ( [Revenue], DATESBETWEEN ( 'public dim_date'[full_date], _start, _end ) ) VAR _py = CALCULATE ( [Revenue], DATESBETWEEN ( 'public dim_date'[full_date], EDATE ( _start, -12 ), EDATE ( _end, -12 ) ) ) RETURN DIVIDE ( _cur - _py, _py )
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 956ed505-986a-4bee-b3d1-ecaf154e847c

	measure 'Invoice Count' = COUNTROWS ( 'public fact_invoice' )
		formatString: #,0
		lineageTag: f4e8a020-db16-4a04-97ea-1e627bbd7170

	measure 'Active Customers' = DISTINCTCOUNT ( 'public fact_invoice'[customer_key] )
		formatString: #,0
		lineageTag: df5f232b-5115-4c64-8362-964ed6b57bbc

	measure 'Avg Invoice Value' = DIVIDE ( [Revenue], [Invoice Count] )
		formatString: €#,0
		lineageTag: 927b6a30-2843-4e15-aaa0-3900f6386f5d

